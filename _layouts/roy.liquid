---
layout: default
title: AI 자기소개 챗봇
subtitle: 저에 대해 궁금한 것을 물어보세요!
nav: false
nav_order: 2
---
<div class="chatbot-page">
  <!-- Clear Chat Confirm Dialog -->
  <div id="clear-chat-confirm" class="clear-chat-confirm" role="dialog" aria-modal="true" aria-labelledby="clear-confirm-title">
    <div class="clear-chat-confirm-box">
      <p class="clear-chat-confirm-title" id="clear-confirm-title">대화를 초기화할까요?</p>
      <p class="clear-chat-confirm-desc">모든 대화 내용이 삭제됩니다.</p>
      <div class="clear-chat-confirm-actions">
        <button class="clear-chat-confirm-no" onclick="cancelClearChat()">취소</button>
        <button class="clear-chat-confirm-yes" onclick="confirmClearChat()">삭제</button>
      </div>
    </div>
  </div>

  <!-- Header -->
  <div class="chatbot-header">
    <div class="chatbot-header-inner">
      <div class="chatbot-brand">
        <div class="chatbot-logo">
          <i class="fas fa-robot"></i>
        </div>
        <div class="chatbot-title-group">
          <h1 class="chatbot-title">Portfolio AI</h1>
          <p class="chatbot-subtitle">개발자 포트폴리오 어시스턴트</p>
        </div>
      </div>
      <div class="chatbot-actions">
        <div id="connectionStatus" class="connection-badge">
          <i class="fas fa-spinner fa-spin"></i>
          <span>연결 확인 중...</span>
        </div>
        <button
          class="chatbot-action-btn"
          onclick="clearChat()"
          data-bs-toggle="tooltip"
          title="대화 초기화"
          aria-label="대화 내용 모두 삭제"
        >
          <i class="fas fa-redo-alt"></i>
        </button>
        <div class="action-divider desktop-only"></div>
        <a href="{{ '/' | relative_url }}" class="chatbot-action-btn desktop-only" title="홈으로">
          <i class="fas fa-home"></i>
        </a>
        <a href="mailto:arh3125@gmail.com" class="chatbot-action-btn desktop-only" title="Gmail">
          <i class="fas fa-envelope"></i>
        </a>
        <!-- Mobile more menu -->
        <div class="mobile-more-menu mobile-only">
          <button
            class="chatbot-action-btn"
            id="mobileMoreBtn"
            onclick="toggleMobileMenu(event)"
            aria-label="더보기"
            aria-expanded="false"
          >
            <i class="fas fa-ellipsis-v"></i>
          </button>
          <div class="mobile-dropdown" id="mobileDropdown" aria-hidden="true">
            <a href="{{ '/' | relative_url }}" class="mobile-dropdown-item">
              <i class="fas fa-home"></i>
              <span>홈으로</span>
            </a>
            <a href="mailto:arh3125@gmail.com" class="mobile-dropdown-item">
              <i class="fas fa-envelope"></i>
              <span>이메일</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="chatbot-main">
    <div class="chatbot-container">
      <!-- User Info Form (shown on first visit) -->
      <div id="user-info-form" class="user-info-form screen-transition" style="display: none;">
        <div class="user-info-icon">
          <i class="fas fa-user-circle"></i>
        </div>
        <h2 class="user-info-title">반갑습니다!</h2>
        <p class="user-info-desc">
          대화를 시작하기 전에 간단히 소개해주세요.
        </p>
        <p class="user-info-optional">
          <i class="fas fa-info-circle"></i>
          입력하지 않아도 대화를 진행할 수 있습니다.
        </p>
        <div class="user-info-fields">
          <div class="user-info-field">
            <label for="visitor-name">이름</label>
            <input type="text" id="visitor-name" placeholder="홍길동" maxlength="50" autocomplete="name">
          </div>
          <div class="user-info-field">
            <label for="visitor-company">회사/소속</label>
            <input type="text" id="visitor-company" placeholder="OO회사" maxlength="100" autocomplete="organization">
          </div>
        </div>
        <div class="user-info-actions">
          <button class="user-info-submit-btn" onclick="submitUserInfo()">
            <i class="fas fa-comments me-2"></i>대화 시작하기
          </button>
          <button class="user-info-skip-btn" onclick="skipUserInfo()">
            건너뛰기
          </button>
        </div>
      </div>

      <!-- Welcome Screen (shown when no messages) -->
      <div id="welcome-screen" class="welcome-screen screen-transition">
        <div class="welcome-icon">
          <i class="fas fa-robot"></i>
        </div>
        <h2 class="welcome-title">포트폴리오 AI 어시스턴트</h2>
        <p class="welcome-desc">
          안녕하세요! 저에 대해 궁금한 점이 있으시면 무엇이든 물어보세요.<br>
          기술 스택, 프로젝트 경험, 연락처 등 자유롭게 질문해주세요.
        </p>
        <div class="quick-questions">
          <button class="quick-question-card" onclick="askQuestion('어떤 기술 스택을 사용하나요?')">
            <div class="quick-question-icon">
              <i class="fas fa-code"></i>
            </div>
            <span class="quick-question-text">어떤 기술 스택을 사용하나요?</span>
          </button>
          <button class="quick-question-card" onclick="askQuestion('주요 프로젝트가 궁금해요')">
            <div class="quick-question-icon">
              <i class="fas fa-briefcase"></i>
            </div>
            <span class="quick-question-text">주요 프로젝트가 궁금해요</span>
          </button>
          <button class="quick-question-card" onclick="askQuestion('연락처를 알려주세요')">
            <div class="quick-question-icon">
              <i class="fas fa-envelope"></i>
            </div>
            <span class="quick-question-text">연락처를 알려주세요</span>
          </button>
        </div>
      </div>

      <!-- Chat Messages -->
      <div id="chat-container" class="chat-container screen-transition" style="display: none;">
        <div id="messages"></div>
      </div>

      <!-- New Message Indicator -->
      <div id="new-message-indicator" class="new-message-indicator" style="display: none;" onclick="scrollToBottom()">
        <i class="fas fa-arrow-down"></i>
        <span>새 메시지</span>
      </div>

      <!-- Suggested Questions -->
      <div
        id="suggestedQuestions"
        class="suggested-questions"
        style="display: none;"
      >
        <div class="suggested-label"><i class="fas fa-lightbulb"></i> 이런 질문은 어떠세요?</div>
        <div id="questionSuggestions" class="suggested-list"></div>
      </div>
    </div>
  </div>

  <!-- Input Footer -->
  <div class="chatbot-footer">
    <div class="chatbot-input-wrapper">
      <div class="chatbot-input-container">
        <textarea
          id="user-input"
          class="chatbot-input"
          placeholder="무엇이든 물어보세요"
          onkeypress="handleKeyPress(event)"
          oninput="autoResizeTextarea(this)"
          maxlength="500"
          aria-label="챗봇에게 질문 입력"
          autocomplete="off"
          rows="1"
        ></textarea>
        <div class="chatbot-composer-bar">
          <div class="chatbot-input-info">
            <span id="responseTime" class="response-time"></span>
            <span class="char-count"><span id="charCount">0</span>/500</span>
          </div>
          <button
            class="chatbot-send-btn"
            id="sendBtn"
            onclick="sendMessage()"
            disabled
            aria-label="메시지 전송"
          >
            <span id="sendBtnText"><i class="fas fa-paper-plane"></i></span>
            <span id="sendBtnLoading" style="display: none;">
              <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* =============================================
     Chatbot Semantic Color Variables
     Light/dark mode adaptive
     ============================================= */
  :root {
    --chatbot-accent: #2563eb;
    --chatbot-accent-strong: #1d4ed8;
    --chatbot-accent-soft: rgba(37, 99, 235, 0.1);
    --chatbot-focus-ring: rgba(37, 99, 235, 0.18);
    --chatbot-success: #0a9e50;
    --chatbot-success-bg: rgba(10, 158, 80, 0.1);
    --chatbot-success-border: rgba(10, 158, 80, 0.2);
    --chatbot-error: #dc2626;
    --chatbot-error-bg: rgba(220, 53, 69, 0.08);
    --chatbot-error-border: rgba(220, 53, 69, 0.22);
    --chatbot-human-color: #0a9e50;
    --chatbot-human-bg: rgba(10, 158, 80, 0.08);
    --chatbot-human-border: rgba(10, 158, 80, 0.2);
    --chatbot-surface-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
    --chatbot-msg-shadow: 0 1px 2px rgba(15, 23, 42, 0.05), 0 8px 20px rgba(15, 23, 42, 0.04);
  }

  [data-theme="dark"] {
    --chatbot-accent: #60a5fa;
    --chatbot-accent-strong: #93c5fd;
    --chatbot-accent-soft: rgba(96, 165, 250, 0.14);
    --chatbot-focus-ring: rgba(96, 165, 250, 0.24);
    --chatbot-success: #05df72;
    --chatbot-success-bg: rgba(13, 84, 43, 0.3);
    --chatbot-success-border: rgba(5, 223, 114, 0.25);
    --chatbot-error: #ff6b6b;
    --chatbot-error-bg: rgba(220, 53, 69, 0.18);
    --chatbot-error-border: rgba(220, 53, 69, 0.35);
    --chatbot-human-color: #05df72;
    --chatbot-human-bg: rgba(16, 185, 129, 0.12);
    --chatbot-human-border: rgba(16, 185, 129, 0.28);
    --chatbot-surface-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
    --chatbot-msg-shadow: 0 1px 4px rgba(0, 0, 0, 0.25), 0 2px 10px rgba(0, 0, 0, 0.15);
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --chatbot-accent: #60a5fa;
      --chatbot-accent-strong: #93c5fd;
      --chatbot-accent-soft: rgba(96, 165, 250, 0.14);
      --chatbot-focus-ring: rgba(96, 165, 250, 0.24);
      --chatbot-success: #05df72;
      --chatbot-success-bg: rgba(13, 84, 43, 0.3);
      --chatbot-success-border: rgba(5, 223, 114, 0.25);
      --chatbot-error: #ff6b6b;
      --chatbot-error-bg: rgba(220, 53, 69, 0.18);
      --chatbot-error-border: rgba(220, 53, 69, 0.35);
      --chatbot-human-color: #05df72;
      --chatbot-human-bg: rgba(16, 185, 129, 0.12);
      --chatbot-human-border: rgba(16, 185, 129, 0.28);
      --chatbot-surface-shadow: 0 10px 30px rgba(0, 0, 0, 0.22);
      --chatbot-msg-shadow: 0 1px 4px rgba(0, 0, 0, 0.25), 0 2px 10px rgba(0, 0, 0, 0.15);
    }
  }

  /* =============================================
     Chatbot Page Layout
     ============================================= */
  body:has(.chatbot-page) {
    overflow: hidden;
  }

  body:has(.chatbot-page) > footer[role="contentinfo"] {
    display: none;
  }

  .chatbot-page {
    --chatbot-floating-composer-space: clamp(7.5rem, 14vh, 10rem);
    --chatbot-floating-composer-bottom: clamp(0.375rem, 1vh, 0.75rem);
    display: flex;
    flex-direction: column;
    height: calc(100vh - 56px);
    height: calc(100dvh - 56px);
    min-height: 0;
    margin-top: -3rem;
    overflow: hidden;
    background: var(--global-bg-color);
  }

  /* =============================================
     Header
     ============================================= */
  .chatbot-header {
    background: var(--global-card-bg-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding: 0.875rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    backdrop-filter: blur(12px);
  }

  .chatbot-header-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .chatbot-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .chatbot-logo {
    width: 40px;
    height: 40px;
    border-radius: 8px;
    background: var(--chatbot-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 1.1rem;
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.22);
  }

  .chatbot-title-group {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .chatbot-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    color: var(--global-text-color);
    line-height: 1.3;
    white-space: nowrap;
  }

  .chatbot-subtitle {
    font-size: 0.8rem;
    color: var(--global-text-color-light);
    margin: 0;
  }

  .chatbot-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .connection-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 32px;
    padding: 0.35rem 0.625rem;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    background: var(--chatbot-success-bg);
    color: var(--chatbot-success);
    border: 1px solid var(--chatbot-success-border);
    transition: all 0.3s ease;
  }

  .connection-badge span {
    max-width: 8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .connection-badge.offline {
    background: var(--chatbot-error-bg);
    color: var(--chatbot-error);
    border-color: var(--chatbot-error-border);
  }

  .connection-badge.pending {
    background: rgba(108, 117, 125, 0.1);
    color: var(--global-text-color-light);
    border-color: rgba(108, 117, 125, 0.25);
  }

  .reconnect-btn {
    background: none;
    border: 1px solid var(--chatbot-error);
    color: var(--chatbot-error);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    cursor: pointer;
    margin-left: 0.25rem;
    transition: all 0.15s ease;
  }

  .reconnect-btn:hover {
    background: var(--chatbot-error);
    color: white;
  }

  .chatbot-action-btn {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    border: none;
    background: transparent;
    color: var(--global-text-color-light);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
  }

  .chatbot-action-btn:hover {
    background: var(--chatbot-accent-soft);
    color: var(--global-text-color);
  }

  .chatbot-action-btn:focus-visible,
  .quick-question-card:focus-visible,
  .suggestion-btn:focus-visible,
  .user-info-submit-btn:focus-visible,
  .user-info-skip-btn:focus-visible,
  .clear-chat-confirm-yes:focus-visible,
  .clear-chat-confirm-no:focus-visible,
  .reconnect-btn:focus-visible,
  .chatbot-send-btn:focus-visible {
    outline: 3px solid var(--chatbot-focus-ring);
    outline-offset: 2px;
  }

  .action-divider {
    width: 1px;
    height: 24px;
    background: var(--global-divider-color);
    margin: 0 0.25rem;
  }

  /* Desktop/Mobile visibility helpers */
  .desktop-only {
    display: flex;
  }

  .mobile-only {
    display: none;
  }

  /* =============================================
     Mobile Dropdown Menu
     ============================================= */
  .mobile-more-menu {
    position: relative;
  }

  .mobile-dropdown {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    background: var(--global-card-bg-color);
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    padding: 0.375rem;
    min-width: 140px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12), 0 2px 8px rgba(0, 0, 0, 0.08);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px) scale(0.97);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 200;
  }

  .mobile-dropdown.open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .mobile-dropdown-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0.875rem;
    min-height: 48px;
    border-radius: 0.5rem;
    color: var(--global-text-color);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: background 0.15s ease;
  }

  .mobile-dropdown-item:hover {
    background: var(--global-divider-color);
    color: var(--global-text-color);
    text-decoration: none;
  }

  .mobile-dropdown-item i {
    width: 16px;
    text-align: center;
    color: var(--global-text-color-light);
  }

  /* =============================================
     Screen Transitions
     ============================================= */
  .screen-transition {
    transition: opacity 0.28s ease, transform 0.28s ease;
  }

  @keyframes screenEnter {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes screenExit {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(-10px);
    }
  }

  .screen-entering {
    animation: screenEnter 0.28s ease forwards;
  }

  .screen-exiting {
    animation: screenExit 0.22s ease forwards;
  }

  /* =============================================
     Main Content
     ============================================= */
  .chatbot-main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    overflow: hidden;
    position: relative;
  }

  .chatbot-container {
    max-width: 900px;
    width: 100%;
    margin: 0 auto;
    padding: 2rem 1.5rem calc(2rem + var(--chatbot-floating-composer-space));
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
  }

  /* =============================================
     User Info Form
     ============================================= */
  .user-info-form {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1rem;
    flex: 1;
  }

  .user-info-icon {
    width: 64px;
    height: 64px;
    border-radius: 8px;
    background: var(--chatbot-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--chatbot-accent);
    font-size: 1.6rem;
    margin-bottom: 1.5rem;
  }

  .user-info-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--global-text-color);
    margin: 0 0 0.75rem 0;
  }

  .user-info-desc {
    font-size: 1rem;
    color: var(--global-text-color-light);
    line-height: 1.6;
    max-width: 400px;
    margin: 0 0 0.5rem 0;
  }

  .user-info-optional {
    font-size: 0.85rem;
    color: var(--global-text-color-light);
    opacity: 0.8;
    margin: 0 0 2rem 0;
  }

  .user-info-optional i {
    margin-right: 0.25rem;
  }

  .user-info-fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: 320px;
    margin-bottom: 1.5rem;
  }

  .user-info-field {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .user-info-field label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--global-text-color);
  }

  .user-info-field input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--global-divider-color);
    border-radius: 8px;
    background: var(--global-bg-color);
    color: var(--global-text-color);
    font-size: 1rem;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .user-info-field input:focus {
    outline: none;
    border-color: var(--chatbot-accent);
    box-shadow: 0 0 0 3px var(--chatbot-focus-ring);
  }

  .user-info-field input::placeholder {
    color: var(--global-text-color-light);
    opacity: 0.6;
  }

  .user-info-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 320px;
  }

  .user-info-submit-btn {
    width: 100%;
    padding: 0.875rem 1.5rem;
    border: none;
    border-radius: 8px;
    background: var(--chatbot-accent);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .user-info-submit-btn:hover {
    transform: translateY(-2px);
    background: var(--chatbot-accent-strong);
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.22);
  }

  .user-info-skip-btn {
    width: 100%;
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--global-text-color-light);
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .user-info-skip-btn:hover {
    color: var(--global-text-color);
    background: var(--global-divider-color);
  }

  /* =============================================
     Welcome Screen
     ============================================= */
  .welcome-screen {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 3rem 1rem;
    flex: 1;
  }

  .welcome-icon {
    width: 64px;
    height: 64px;
    border-radius: 8px;
